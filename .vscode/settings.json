{
  "editor.formatOnSave": true,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.rulers": [100],
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.associations": {
    "*.h": "c",
    "*.c": "c"
  },

  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/src/**",
    "${workspaceFolder}/sim",
    "${workspaceFolder}/app",
    "${workspaceFolder}/bsp/CH579/StdPeriphDriver/inc",
    "${workspaceFolder}/lib/FreeRTOS/include",
    "${workspaceFolder}/lib/FreeRTOS/Portable/RVDS/ARM_CM0",
    "${workspaceFolder}/lib/CMSIS/Include"
  ],
  "C_Cpp.default.defines": ["FAKE_FREERTOS"],
  "C_Cpp.default.cStandard": "c99",
  "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",

  "cmake.configureOnOpen": true,
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "cmake.configureArgs": ["-DPC_SIM=ON"],
  "cmake.generator": "Unix Makefiles",

  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.enhancedColorization": "enabled"
}
