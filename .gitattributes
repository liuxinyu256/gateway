# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files for CRLF conversion on checkout
*.c text eol=crlf
*.h text eol=crlf
*.cpp text eol=crlf
*.hpp text eol=crlf
*.txt text eol=crlf
*.md text eol=crlf
*.cmake text eol=crlf
*.yaml text eol=crlf
*.yml text eol=crlf
*.json text eol=crlf
*.py text eol=crlf
*.sh text eol=crlf
*.bat text eol=crlf
*.gitignore text eol=crlf
*.gitattributes text eol=crlf
CMakeLists.txt text eol=crlf
