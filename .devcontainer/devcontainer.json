{
  "name": "Gateway - CH579 BLE HVAC (C + CMake + ARM)",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-debian-12",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "containerEnv": {
    "SHELL": "/bin/bash"
  },

  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y gcc-arm-none-eabi ninja-build cppcheck lcov",

  "postCreateCommand": "cd ${containerWorkspaceFolder} && mkdir -p build && cd build && cmake .. -G \"Unix Makefiles\" -DPC_SIM=ON && cmake --build . -j$(nproc)",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "ms-vscode.cpptools-extension-pack",
        "usernamehw.errorlens",
        "yzhang.markdown-all-in-one",
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "files.eol": "\n",
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,

        "C_Cpp.default.compileCommands": "${containerWorkspaceFolder}/build/compile_commands.json",
        "C_Cpp.default.includePath": [
          "${containerWorkspaceFolder}/src/**",
          "${containerWorkspaceFolder}/sim",
          "${containerWorkspaceFolder}/app",
          "${containerWorkspaceFolder}/bsp/CH579/StdPeriphDriver/inc",
          "${containerWorkspaceFolder}/lib/FreeRTOS/include",
          "${containerWorkspaceFolder}/lib/FreeRTOS/Portable/RVDS/ARM_CM0",
          "${containerWorkspaceFolder}/lib/CMSIS/Include"
        ],
        "C_Cpp.default.defines": ["FAKE_FREERTOS"],
        "C_Cpp.default.cStandard": "c99",
        "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",

        "cmake.configureOnOpen": true,
        "cmake.buildDirectory": "${workspaceFolder}/build",
        "cmake.configureArgs": ["-DPC_SIM=ON"],
        "cmake.generator": "Unix Makefiles"
      }
    }
  },

  "forwardPorts": [],
  "remoteUser": "vscode"
}
